{
  "name": "cardex",
  "version": "0.3.3",
  "description": "Gestor de colección de cartas: JCC Pokémon y Riftbound",
  "main": "./out/main/index.js",
  "author": "LordAntonio99",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/LordAntonio99/cardex.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "postinstall": "electron-builder install-app-deps",
    "models:fetch": "node scripts/fetch-models.mjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "catalog:build": "node scripts/build-catalog.mjs",
    "catalog:sample": "node scripts/build-catalog.mjs --sets sv03 --limit 30",
    "catalog:recognition": "node scripts/build-catalog.mjs --recognition",
    "recog:eval": "node scripts/recog-eval.mjs",
    "catalog:check": "node scripts/validate-catalog.mjs",
    "catalog:serve": "node scripts/serve-catalog.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "^1.29.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "selfsigned": "^5.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  }
}
